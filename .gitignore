# Market data — fetched via scripts/fetch_data.py, never committed (116 MB).
# The directory itself is tracked via data/.gitkeep so a clean clone has somewhere
# for `make fetch` to land.
data/*
!data/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.eggs/
build/
dist/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
uv.lock.bak

# The assessment brief itself is Macquarie's material, not ours to redistribute.
# The README states the requirements in our own words instead.
*.docx
~$*.docx

# Editors / OS
.vscode/
.idea/
.DS_Store

# Streamlit
.streamlit/secrets.toml
